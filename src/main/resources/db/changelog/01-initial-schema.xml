<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <preConditions onFail="WARN">
        <not>
            <tableExists tableName="DB_LIQUIBASE"/>
        </not>
    </preConditions>
    <changeSet id="01" author="kanstantin">
        <createTable tableName="product"
                     remarks="A table to contain all products">
            <column name="id" type="int">
                <constraints nullable="false"></constraints>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="varchar(2048)">
                <constraints nullable="true" unique="false"/>
            </column>
            <column name="calories" type="float"></column>
            <column name="proteins" type="float"></column>
            <column name="fats" type="float"></column>
            <column name="carbohydrates" type="float"></column>
        </createTable>

        <addPrimaryKey columnNames="id"
                       constraintName="pk_product"
                       tableName="product"/>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="10000"
                          tableName="product"/>

        <createTable tableName="category"
                     remarks="A table with category names">
            <column name="id" type="int">
                <constraints nullable="false"></constraints>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="varchar(2048)">
                <constraints nullable="true" unique="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="id"
                       constraintName="pk_category"
                       tableName="category"/>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="200"
                          tableName="category"/>

        <createTable tableName="product_categories"
                     remarks="A table with list of product categories">
            <column name="id" type="int">
                <constraints nullable="false"></constraints>
            </column>
            <column name="product_id" type="int">
                <constraints unique="false" nullable="true"></constraints>

            </column>
            <column name="category_id" type="int">
                <constraints unique="false" nullable="true"></constraints>
            </column>
        </createTable>

        <addPrimaryKey columnNames="id"
                       constraintName="pk_product_categories"
                       tableName="product_categories"/>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="1"
                          tableName="product_categories"
        />
    </changeSet>

    <changeSet author="kanstantin" id="02">
                <loadData encoding="UTF-8"
                                file="db/data/products.csv"
                                tableName="product">
                    <column name="id" header="id" type="NUMERIC"/>
                    <column name="name" header="name" type="STRING"/>
                    <column name="calories" header="calories" type="NUMERIC"/>
                    <column name="proteins" header="proteins" type="NUMERIC"/>
                    <column name="fats" header="fats" type="NUMERIC"/>
                    <column name="carbohydrates" header="carbohydrates" type="NUMERIC"/>
                </loadData>
                <loadData encoding="UTF-8"
                                file="db/data/categories.csv"
                                tableName="category">
                    <column name="id" type="NUMERIC"/>
                    <column name="name" type="STRING"/>
                </loadData>
                <loadData encoding="UTF-8"
                                file="db/data/product_categories.csv"
                                tableName="product_categories">
                    <column name="product_id" type="NUMERIC"/>
                    <column name="category_id" type="NUMERIC"/>
                </loadData>
    </changeSet>

    <changeSet id="03" author="kanstantin">
        <createTable tableName="dish">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1024)"/>
        </createTable>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="1"
                          tableName="dish"/>
    </changeSet>

    <changeSet id="04" author="kanstantin">
        <createTable tableName="ingredient">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(255)"/>
            <column name="amount" type="FLOAT"/>
            <column name="product_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="dish_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="1"
                          tableName="ingredient"/>

        <addForeignKeyConstraint
                baseTableName="ingredient"
                baseColumnNames="product_id"
                referencedTableName="product"
                referencedColumnNames="id"
                constraintName="fk_ingredients_product"/>

        <addForeignKeyConstraint
                baseTableName="ingredient"
                baseColumnNames="dish_id"
                referencedTableName="dish"
                referencedColumnNames="id"
                constraintName="fk_ingredients_dish"/>
    </changeSet>

    <changeSet id="05" author="kanstantin">
        <createTable tableName="dish_ingredients">
            <column name="dish_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ingredient_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="dish_ingredients"
                baseColumnNames="dish_id"
                referencedTableName="dish"
                referencedColumnNames="id"
                constraintName="fk_dish_ingredients_dish"/>

        <addForeignKeyConstraint
                baseTableName="dish_ingredients"
                baseColumnNames="ingredient_id"
                referencedTableName="ingredient"
                referencedColumnNames="id"
                constraintName="fk_dish_ingredients_ingredients"/>
    </changeSet>

    <changeSet id="06" author="kanstantin">
        <createTable tableName="trip">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1024)"/>
            <column name="start_date" type="date"/>
            <column name="end_date" type="date"/>
            <column name="participants" type="int"/>
            <column name="comment" type="varchar2(2048)"/>
        </createTable>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="1"
                          tableName="trip"/>
    </changeSet>

    <changeSet id="07" author="kanstantin">
        <createTable tableName="tripday">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="participants" type="int"/>
            <column name="comment" type="varchar2(2048)"/>
            <column name="trip_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="1"
                          tableName="tripday"/>

        <addForeignKeyConstraint
                baseTableName="tripday"
                baseColumnNames="trip_id"
                referencedTableName="trip"
                referencedColumnNames="id"
                constraintName="fk_tripday_trip"/>
    </changeSet>

    <changeSet id="08" author="kanstantin">
        <createTable tableName="tripmeal">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="varchar2(2048)"/>
            <column name="tripday_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="1"
                          tableName="tripmeal"/>

        <addForeignKeyConstraint
                baseTableName="tripmeal"
                baseColumnNames="tripday_id"
                referencedTableName="tripday"
                referencedColumnNames="id"
                constraintName="fk_tripmeal_tripday"/>
    </changeSet>

    <changeSet id="09" author="kanstantin">
        <createTable tableName="tripmeal_dishes">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tripmeal_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="dish_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement columnDataType="int"
                          columnName="id"
                          incrementBy="1"
                          startWith="1"
                          tableName="tripmeal"/>

        <addForeignKeyConstraint
                baseTableName="tripmeal_dishes"
                baseColumnNames="tripmeal_id"
                referencedTableName="tripmeal"
                referencedColumnNames="id"
                constraintName="fk_tripmeal_dishes_tripmeal"/>

        <addForeignKeyConstraint
                baseTableName="tripmeal_dishes"
                baseColumnNames="dish_id"
                referencedTableName="dish"
                referencedColumnNames="id"
                constraintName="fk_tripmeal_dishes_dish"/>
    </changeSet>
</databaseChangeLog>
